<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Items API - TestNG Suite
  ========================
  Run with:   mvn test
              mvn test -Dbase.url=http://myserver:8080

  Groups
  ......
  create    - POST /api/items tests  (run first; read/update depend on them)
  read      - GET  tests
  update    - PUT  tests
  delete    - DELETE tests
  lifecycle - end-to-end Create-Read-Update-Delete chain
-->
<suite name="Items API Suite" parallel="false" verbose="2">

  <listeners>
    <listener class-name="org.testng.reporters.SuiteHTMLReporter"/>
    <listener class-name="org.testng.reporters.XMLReporter"/>
  </listeners>

  <!--
    All classes that declare dependsOnGroups="create" must be in the same
    <test> block as CreateItemTest, so TestNG can resolve the "create" group.
    We run all five classes together and use <groups><run> to control ordering.
  -->
  <test name="Create Tests">
    <groups>
      <run>
        <include name="create"/>
      </run>
    </groups>
    <classes>
      <class name="pl.ldz.example.tests.CreateItemTest"/>
    </classes>
  </test>

  <test name="Read Tests">
    <groups>
      <run>
        <include name="create"/>
        <include name="read"/>
      </run>
    </groups>
    <classes>
      <class name="pl.ldz.example.tests.CreateItemTest"/>
      <class name="pl.ldz.example.tests.GetItemTest"/>
    </classes>
  </test>

  <test name="Update Tests">
    <groups>
      <run>
        <include name="create"/>
        <include name="update"/>
      </run>
    </groups>
    <classes>
      <class name="pl.ldz.example.tests.CreateItemTest"/>
      <class name="pl.ldz.example.tests.UpdateItemTest"/>
    </classes>
  </test>

  <test name="Delete Tests">
    <groups>
      <run>
        <include name="delete"/>
      </run>
    </groups>
    <classes>
      <class name="pl.ldz.example.tests.DeleteItemTest"/>
    </classes>
  </test>

  <test name="CRUD Lifecycle">
    <groups>
      <run>
        <include name="lifecycle"/>
      </run>
    </groups>
    <classes>
      <class name="pl.ldz.example.tests.CrudLifecycleTest"/>
    </classes>
  </test>

</suite>
