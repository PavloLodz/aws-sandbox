# Environment variables for docker-compose local dev.
# Copy this file to .env and adjust as needed.
# .env is excluded from git via .gitignore.

# PostgreSQL
DB_NAME=aws_attempt
DB_USERNAME=postgres
DB_PASSWORD=postgres

# App
APP_PORT=8080

# S3 — LocalStack is used automatically in docker-compose.
# Override these if you want to point at a real bucket locally.
S3_BUCKET=local-bucket
S3_REGION=us-east-1
