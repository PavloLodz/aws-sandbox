# AWS deployment environment variables.
# Copy this file to .env.aws and fill in real values before deploying.
# Never commit .env.aws to version control.
#
# How to use depending on your AWS service:
#
#   Elastic Beanstalk:  paste into Configuration > Software > Environment properties
#   ECS (task def):     add to "environment" block or reference an SSM/Secrets Manager ARN
#   EKS:                create a Kubernetes Secret and inject as envFrom
#   Lambda:             set under Configuration > Environment variables

# ── Spring ────────────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=aws

# ── RDS (PostgreSQL) ──────────────────────────────────────────────────────────
# Elastic Beanstalk sets these automatically when an RDS instance is attached.
# For ECS/EKS/Lambda set them manually to match your RDS endpoint.
RDS_HOSTNAME=your-rds-instance.xxxxxxxxxxxx.eu-west-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=aws_attempt
RDS_USERNAME=postgres
RDS_PASSWORD=change-me

# ── Application ───────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── S3 ────────────────────────────────────────────────────────────────────────
S3_BUCKET=your-s3-bucket-name
S3_REGION=eu-central-1
