# Copy this file to your home directory as ~/.testcontainers.properties
# to fix: "client version 1.32 is too old. Minimum supported API version is 1.40"
#
# This tells Testcontainers to connect directly via the Unix socket
# and skip the Docker client API version check.
docker.client.strategy=org.testcontainers.dockerclient.UnixSocketClientProviderStrategy
testcontainers.reuse.enable=false
