# Copy this file to .env before running docker compose.
# NEVER commit .env — it is gitignored.

# PostgreSQL container configuration
DB_NAME=myapp
DB_USERNAME=myapp
DB_PASSWORD=changeme

# DB_HOST and DB_PORT are set automatically by docker-compose.yml
# (DB_HOST=db, DB_PORT=5432) — do not override unless you know what you are doing.

# Host port the app is published on
APP_PORT=8080
