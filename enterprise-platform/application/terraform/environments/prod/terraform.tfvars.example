# Production environment
# Run: terraform apply -var-file="environments/prod/terraform.tfvars"

environment        = "prod"
aws_region         = "eu-central-1"
availability_zones = ["eu-central-1a", "eu-central-1b"]
vpc_cidr           = "10.1.0.0/16"

# EC2
key_pair_name     = "aws-attempt-prod-key"
ec2_instance_type = "t3.small"

# RDS
db_name     = "aws_attempt"
db_username = "postgres"
# db_password — set via env var: export TF_VAR_db_password="your-secret"

# S3
s3_bucket_name = "aws-attempt-prod-uploads-CHANGEME"  # must be globally unique
